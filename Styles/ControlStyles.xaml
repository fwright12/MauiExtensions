<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
                    xmlns:maui="clr-namespace:Microsoft.Maui.Controls;assembly=MauiExtensions"
                    xmlns:ext="clr-namespace:Microsoft.Maui.Controls.Extensions;assembly=MauiExtensions"
                    x:Class="Microsoft.Maui.Controls.ControlStyles">
    <!-- ================================== VIEWS ================================== -->

    <Style TargetType="Button"
           Class="Destructive">
        <Setter Property="TextColor"
                Value="{OnPlatform iOS='Red'}" />
        <Setter Property="BackgroundColor"
                Value="{OnPlatform Android='Red'}" />
    </Style>

    <Style TargetType="ScrollView"
           Class="HidesTabBarOnScroll">
        <Style.Behaviors>
            <maui:AddStatefulTriggerActionBehavior x:TypeArguments="ext:HideTabBarOnScrollTrigger"
                                                   Event="Scrolled" />
        </Style.Behaviors>
    </Style>

    <Style TargetType="ext:SelectView">
        <Setter Property="ControlTemplate">
            <ext:SimpleSelectTemplate />
        </Setter>

        <Setter Property="IsEditing"
                Value="{Binding SelectionMode, Source={RelativeSource AncestorType={x:Type SelectableItemsView}}, Converter={maui:Converter Type={x:Type ext:SelectionModeToEditingConverter}}}" />

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup Name="CommonStates">
                    <VisualState Name="{Static VisualStateManager+CommonStates.Normal}" />

                    <VisualState Name="{Static VisualStateManager+CommonStates.Selected}">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="Transparent" />
                            <Setter Property="IsSelected"
                                    Value="True" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="SwipeItem"
           Class="Destructive">
        <Setter Property="BackgroundColor"
                Value="Red" />
    </Style>

    <!-- ================================== LAYOUTS ================================== -->

    <!-- ================================== PAGES ================================== -->
</ResourceDictionary>
