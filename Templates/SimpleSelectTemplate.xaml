<?xml version="1.0" encoding="utf-8" ?>
<ControlTemplate xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 xmlns:ext="clr-namespace:Microsoft.Maui.Controls.Extensions;assembly=MauiExtensions"
                 x:Class="Microsoft.Maui.Controls.Extensions.SimpleSelectTemplate"
                 x:DataType="ext:SelectView">
    <FlexLayout Direction="{OnPlatform iOS=RowReverse, Android=Row}"
                InputTransparent="{TemplateBinding IsEditing}">
        <ContentPresenter FlexLayout.Grow="1" />

        <CheckBox IsChecked="{TemplateBinding IsSelected}"
                  IsVisible="{TemplateBinding IsEditing}"
                  FlexLayout.Shrink="0" />
    </FlexLayout>
</ControlTemplate>
